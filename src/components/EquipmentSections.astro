---
import Section from './Section.astro';
import Prose from './Prose.astro';
import Figure from './Figure.astro';
import type { SiteContent } from '../content/types';
import { getAlt } from '../content/alt';
import { site, type Locale } from '../site';
import { t } from '../i18n/ui';

import swordRedGrip from '../assets/photos/sword-red-grip.jpg';
import glovesBind from '../assets/photos/gloves-bind.jpg';

interface Props {
  content: SiteContent['equipment'];
  locale: Locale;
}

const { content, locale } = Astro.props;
const alt = getAlt(locale);
const strings = t(locale);
---

{/* ---- What beginners actually need -------------------------------------- */}
<Section labelledby="beginner-title">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 id="beginner-title" class="text-h2">{content.beginner.title}</h2>
      <Prose body={content.beginner.body} class="mt-6 max-w-[56ch]" />
    </div>
    <div class="lg:col-span-5">
      <Figure
        image={swordRedGrip}
        alt={alt.swordRedGrip}
        sizes="(min-width: 1024px) 40vw, 100vw"
        aspect="aspect-[4/5]"
        position="50% 40%"
      />
    </div>
  </div>
</Section>

{/* ---- The full kit ------------------------------------------------------ */}
<Section tone="raised" divider labelledby="full-title">
  <div class="max-w-[52ch]">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="full-title" class="text-h2 mt-5">{content.fullTitle}</h2>
    <p class="text-ink-muted mt-6 leading-relaxed">{content.fullLead}</p>
  </div>

  <div class="mt-14 space-y-14">
    {
      content.requirements.map((group) => (
        <div class="border-line grid gap-6 border-t pt-8 lg:grid-cols-12 lg:gap-16">
          <h3 class="text-ink lg:col-span-3 text-[0.75rem] font-semibold tracking-[0.2em] uppercase">
            {group.title}
          </h3>
          <div class="lg:col-span-9">
            <p class="text-ink-muted max-w-[64ch] leading-relaxed">{group.lead}</p>

            <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-12">
              <div>
                <p class="text-accent-ink text-[0.7rem] font-semibold tracking-[0.2em] uppercase">
                  {strings.gearRequired}
                </p>
                <ul class="border-line mt-4 space-y-3 border-t">
                  {group.required.map((item) => (
                    <li class="border-line text-ink border-b pb-3 text-base leading-relaxed">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-ink-faint text-[0.7rem] font-semibold tracking-[0.2em] uppercase">
                  {strings.gearRecommended}
                </p>
                <ul class="border-line mt-4 space-y-3 border-t">
                  {group.recommended.map((item) => (
                    <li class="border-line text-ink-muted border-b pb-3 text-base leading-relaxed">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {/* ---- The maintained document this page summarises --------------------- */}
  <div class="border-line bg-surface mt-14 border p-7 lg:p-8">
    <h3 class="text-h3">{content.doc.title}</h3>
    <Prose body={content.doc.body} class="mt-4 max-w-[58ch] text-base" />
    <a href={site.links.equipmentDoc} target="_blank" rel="noopener" class="btn btn-ghost mt-7">
      {content.doc.linkLabel}
    </a>
  </div>

  <p class="border-accent text-ink-muted mt-14 max-w-[62ch] border-l-2 py-1 pl-5 leading-relaxed">
    {content.outro}
  </p>
</Section>

<div class="container-page py-(--spacing-section)">
  <Figure
    image={glovesBind}
    alt={alt.glovesBind}
    sizes="100vw"
    widths={[640, 960, 1280, 1600, 2000, 2400]}
    aspect="aspect-[21/9]"
  />
</div>
