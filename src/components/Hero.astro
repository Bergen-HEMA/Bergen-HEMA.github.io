---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, type Locale } from '../site';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary: string;
  secondary: string;
  secondaryHref: string;
  image: ImageMetadata;
  imageAlt: string;
  locale: Locale;
}

const { eyebrow, title, lead, primary, secondary, secondaryHref, image, imageAlt } = Astro.props;
---

<section class="relative isolate flex min-h-[max(38rem,88svh)] flex-col justify-end overflow-hidden">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1600, 2000, 2400, 2800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_38%] sm:object-[50%_42%]"
  />
  <div class="scrim-bottom absolute inset-0 -z-10"></div>

  <div class="container-page pt-32 pb-16 lg:pb-24">
    <p class="eyebrow eyebrow-over text-shadow-cinema">{eyebrow}</p>

    <h1 class="text-display text-shadow-cinema mt-6 max-w-[17ch] font-semibold">
      {title}
    </h1>

    {/* Full-strength ink rather than a softened tint: this paragraph sits over
        bright overcast stone, where every percent of opacity counts. */}
    <p class="text-lead text-ink text-shadow-cinema mt-7 max-w-[48ch]">
      {lead}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href={site.links.spond} target="_blank" rel="noopener" class="btn btn-primary">
        {primary}
      </a>
      <a href={secondaryHref} class="btn btn-ghost">{secondary}</a>
    </div>
  </div>
</section>
