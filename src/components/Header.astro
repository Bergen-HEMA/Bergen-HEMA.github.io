---
import Logo from './Logo.astro';
import { site, type Locale } from '../site';
import { navOrder, otherLocale, path, routes, t, type RouteKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  current: RouteKey;
}

const { locale, current } = Astro.props;
const strings = t(locale);
const other = otherLocale(locale);
---

<header
  class="border-line/70 bg-surface/72 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl backdrop-saturate-150"
>
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <Logo locale={locale} class="shrink-0" />

    <nav aria-label={strings.navMenu} class="hidden items-center gap-5 lg:flex xl:gap-7">
      {
        navOrder.map((key) => (
          <a
            href={path(locale, key)}
            aria-current={current === key ? 'page' : undefined}
            class:list={[
              'relative shrink-0 py-1 text-[0.8rem] font-medium tracking-[0.06em] whitespace-nowrap uppercase no-underline transition-colors duration-200',
              'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100',
              current === key ? 'text-ink after:scale-x-100' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {strings.navShort[key]}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={routes[current][other]}
        hreflang={other === 'no' ? 'nb' : 'en'}
        lang={other === 'no' ? 'nb' : 'en'}
        aria-label={strings.langSwitchLabel}
        class="border-line-strong text-ink-muted hover:border-ink hover:text-ink hidden border px-2.5 py-1.5 text-[0.7rem] font-semibold tracking-[0.12em] uppercase no-underline transition-colors duration-200 sm:inline-flex"
      >
        {other === 'no' ? 'NO' : 'EN'}
      </a>

      <a href={site.links.spond} target="_blank" rel="noopener" class="btn btn-primary hidden md:inline-flex">
        {strings.joinCta}
      </a>

      <button
        type="button"
        id="nav-toggle"
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="border-line-strong text-ink hover:border-ink inline-flex h-10 w-10 items-center justify-center border transition-colors duration-200 lg:hidden"
      >
        <span class="sr-only">{strings.navMenu}</span>
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" fill="none">
          <path
            d="M0 1h18M0 7h18M0 13h18"
            stroke="currentColor"
            stroke-width="1.5"
            data-icon="open"></path>
          <path
            d="M1 1l16 12M17 1L1 13"
            stroke="currentColor"
            stroke-width="1.5"
            data-icon="close"
            class="hidden"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation. Hidden with `hidden` rather than height animation so
       that it is genuinely removed from the tab order when closed. -->
  <div id="mobile-nav" class="border-line/70 bg-surface hidden border-y lg:hidden">
    <nav aria-label={strings.navMenu} class="container-page flex flex-col py-4">
      {
        navOrder.map((key) => (
          <a
            href={path(locale, key)}
            aria-current={current === key ? 'page' : undefined}
            class:list={[
              'border-line/60 border-b py-3.5 text-sm font-medium tracking-[0.05em] uppercase no-underline transition-colors duration-200',
              current === key ? 'text-accent-ink' : 'text-ink hover:text-accent-ink',
            ]}
          >
            {strings.nav[key]}
          </a>
        ))
      }
      <div class="mt-5 flex items-center gap-3">
        <a
          href={site.links.spond}
          target="_blank"
          rel="noopener"
          class="btn btn-primary grow justify-center"
        >
          {strings.joinCta}
        </a>
        <a
          href={routes[current][other]}
          hreflang={other === 'no' ? 'nb' : 'en'}
          lang={other === 'no' ? 'nb' : 'en'}
          aria-label={strings.langSwitchLabel}
          class="border-line-strong text-ink-muted hover:border-ink hover:text-ink inline-flex items-center border px-3.5 py-3 text-[0.7rem] font-semibold tracking-[0.12em] uppercase no-underline transition-colors duration-200"
        >
          {other === 'no' ? 'NO' : 'EN'}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- The only script on the site. Inlined so it costs no extra request. -->
<script is:inline>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;

    const icons = toggle.querySelectorAll('[data-icon]');
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      icons.forEach((icon) => {
        icon.classList.toggle('hidden', (icon.dataset.icon === 'open') === open);
      });
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when the layout grows past the mobile breakpoint, so the panel
    // cannot stay open behind the desktop navigation.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => event.matches && setOpen(false));
  })();
</script>
