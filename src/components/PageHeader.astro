---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Nudges the focal point when the crop cuts off the subject. */
  position?: string;
}

const { eyebrow, title, lead, image, imageAlt, position = '50% 40%' } = Astro.props;
---

<div class="relative isolate overflow-hidden">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1440, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    style={`object-position: ${position}`}
  />
  <div class="scrim-header absolute inset-0 -z-10"></div>

  <div class="container-page flex min-h-[clamp(20rem,42vw,30rem)] flex-col justify-end pt-32 pb-14 lg:pb-20">
    <p class="eyebrow eyebrow-over text-shadow-cinema">{eyebrow}</p>
    <h1 class="text-h1 text-shadow-cinema mt-5 max-w-[16ch]">{title}</h1>
    {
      lead && (
        <p class="text-lead text-ink-muted text-shadow-cinema mt-6 max-w-[46ch]">{lead}</p>
      )
    }
  </div>
</div>
