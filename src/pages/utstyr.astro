---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EquipmentSections from '../components/EquipmentSections.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../content';
import { getAlt } from '../content/alt';
import headerImage from '../assets/photos/swords-stone-wall.jpg';
import ctaImage from '../assets/photos/sparring-lunge.jpg';

const locale = 'no' as const;
const all = getContent(locale);
const content = all.equipment;
const alt = getAlt(locale);
---

<Base locale={locale} current="equipment">
  <PageHeader
    eyebrow={content.eyebrow}
    title={content.title}
    lead={content.lead}
    image={headerImage}
    imageAlt={alt.swordsStoneWall}
    position="50% 50%"
  />

  <EquipmentSections content={content} locale={locale} />

  <CtaBand
    title={all.home.cta.title}
    lead={all.home.cta.lead}
    image={ctaImage}
    imageAlt={alt.sparringLunge}
    locale={locale}
    position="50% 55%"
  />
</Base>
